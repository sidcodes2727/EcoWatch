# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API Key
# Obtain from Google AI Studio (https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Campus Center Coordinates (Optional - defaults to 19.0222, 72.8561)
VITE_CAMPUS_CENTER_LAT=19.0222
VITE_CAMPUS_CENTER_LNG=72.8561
